{
  "name": "@baerae-zkap/zkap-aa",
  "version": "0.0.29",
  "description": "A TypeScript SDK for interacting with ZKAP Abstract Account contracts easily.",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --coverageReporters=text-summary",
    "build": "tsc",
    "pub": "sh ./publish.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baerae-zkap/zkap-aa.git"
  },
  "author": {
    "name": "baerae-zkap",
    "email": "k@baerae.com"
  },
  "license": "ISC",
  "publishConfig": {
    "registry": "https://asia-northeast3-npm.pkg.dev/zkap-dev/zkap-npm-packages/"
  },
  "bugs": {
    "url": "https://github.com/baerae-zkap/zkap-aa/issues"
  },
  "homepage": "https://github.com/baerae-zkap/zkap-aa#readme",
  "files": [
    "dist/lib/",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@levischuck/tiny-cbor": "^0.2.11",
    "ethers": "^6.13.5",
    "jwt-decode": "^4.0.0"
  },
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
