{
  "name": "@baerae-zkap/zkap-aa",
  "version": "0.1.0",
  "description": "A TypeScript SDK for interacting with ZKAP Abstract Account contracts easily.",
  "keywords": [
    "erc-4337",
    "account-abstraction",
    "smart-wallet",
    "useroperation",
    "bundler",
    "zk",
    "zkap",
    "passkey",
    "webauthn",
    "zk-oidc",
    "typescript",
    "sdk",
    "ethers"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --coverageReporters=text-summary",
    "lint": "eslint \"lib/**/*.ts\" --fix",
    "build": "tsc && tsc -p tsconfig.esm.json && node scripts/add-esm-ext.mjs",
    "pub": "sh ./publish.sh",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baerae-zkap/zkap.git"
  },
  "author": {
    "name": "baerae-zkap",
    "email": "k@baerae.com"
  },
  "license": "ISC",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/baerae-zkap/zkap/issues"
  },
  "homepage": "https://github.com/baerae-zkap/zkap#readme",
  "files": [
    "dist/lib/",
    "dist/esm/",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@levischuck/tiny-cbor": "^0.3.2",
    "ethers": "^6.13.5",
    "jwt-decode": "^4.0.0"
  },
  "main": "dist/lib/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
