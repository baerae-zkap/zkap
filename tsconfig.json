{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2020",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "composite": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "node"
  },
  // `.json` is deliberately NOT a program root: nothing in lib/ may import JSON at
  // runtime (native ESM would need an import attribute). Re-adding "lib/**/*.json"
  // makes tsc copy the Hardhat artifacts into dist again — ~820 KB of bytecode and
  // metadata no runtime code reads. ABIs come from lib/types/abi/generated.ts.
  // Note tsconfig.eslint.json DOES keep the glob: it includes tests, and two of
  // them import a JSON fixture, which composite builds require to be listed.
  "include": ["lib/**/*"],
  "exclude": ["node_modules", "dist", "lib/**/__tests__/**"]
}
