# --- Chain config (no registry: you supply all of this) ---

# Chain ID of the target network
CHAIN_ID=11155111

# JSON-RPC node endpoint — used for gas estimation and nonce reads
RPC_URL=https://sepolia.example.com/rpc

# ERC-4337 bundler RPC endpoint (Pimlico, Alchemy, Stackup, self-hosted alto).
# A different service from RPC_URL. Required by `send`.
BUNDLER_URL=https://public.pimlico.io/v2/11155111/rpc

# ERC-4337 EntryPoint contract (v0.8)
ENTRY_POINT=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# --- Wallet ---

# Your ZKAP smart wallet address (already deployed on the target chain).
# Run `node index.js derive` to compute it for a not-yet-deployed wallet.
WALLET_ADDRESS=0xYourZkapWalletAddress

# Private key of an EOA that is registered as a key on the above wallet
# Never commit a real key — this is for testnet only
PRIVATE_KEY=0xYourPrivateKey

# --- Transfer (send) ---

# Recipient for the test transfer
TO_ADDRESS=0xRecipientAddress

# Amount to send in wei (default: 0 — dry-run with 0 ETH transfer)
VALUE_WEI=0

# --- Address derivation (derive only) ---

# ZkapAccountFactory contract on the target chain
FACTORY_ADDRESS=0xYourZkapFactoryAddress

# On-chain verifier logic contract for keyAddress (EOA) keys
ADDRESS_KEY_LOGIC=0xYourAddressKeyLogicAddress

# OAuth audience (client_id) and subject the wallet is derived from
AUD=your-google-client-id
SUB=user-subject-from-provider
