# Chain ID to use (run `node index.js chains` to list supported chains)
CHAIN_ID=11155111

# Your ZKAP smart wallet address (already deployed on the target chain)
WALLET_ADDRESS=0xYourZkapWalletAddress

# Private key of an EOA that is registered as a key on the above wallet
# Never commit a real key — this is for testnet only
PRIVATE_KEY=0xYourPrivateKey

# Recipient for the test transfer
TO_ADDRESS=0xRecipientAddress

# Amount to send in wei (default: 0 — dry-run with 0 ETH transfer)
VALUE_WEI=0
